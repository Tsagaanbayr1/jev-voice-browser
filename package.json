{
  "name": "jev-voice-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Жинхэнэ хөтчийг дуу хоолойгоор удирдана. Jev (TypeSafe System One) санаархал/зорилтыг ~100-300 мс дотор шийдэж, Playwright гүйцэтгэнэ. Монгол хэлний бүрэн дэмжлэгтэй fork.",
  "keywords": [
    "voice",
    "browser",
    "mongolian",
    "jev",
    "typesafe",
    "playwright",
    "speech",
    "accessibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "demo": "node scripts/demo.js",
    "demo:ci": "node scripts/demo.js --headless",
    "test": "node --test 'test/unit/**/*.test.js'",
    "test:integration": "node --test 'test/integration/**/*.test.js'",
    "test:all": "node --test 'test/unit/**/*.test.js' 'test/integration/**/*.test.js'"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "author": "Tsagaanbayr1 (fork); Moritz Kremb (original work)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tsagaanbayr1/jev-voice-browser.git"
  },
  "homepage": "https://github.com/Tsagaanbayr1/jev-voice-browser#readme",
  "upstream": {
    "type": "git",
    "url": "https://github.com/moritzkremb/jev-voice-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Tsagaanbayr1/jev-voice-browser/issues"
  }
}
